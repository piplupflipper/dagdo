# dagdo 環境変数一覧 (docs/auth-design.md 第8章)
#
# 実際の値は .env.local (gitignore 対象) または Vercel の環境変数設定に置く。
# 以下はローカル Supabase (`npx supabase start`) を使う場合の値の例であり、
# 本物の secret はここに書かない。

# Auth.js が cookie の署名・CSRF トークン生成等に用いる秘密鍵 (Auth.js 標準の必須環境変数)
# 生成例: `npx auth secret` または `openssl rand -base64 33`
AUTH_SECRET=

# GitHub OAuth App のクライアント ID / シークレット
# 取得元: https://github.com/settings/developers で OAuth App を作成する
# ローカル開発用の Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Supabase プロジェクトの URL
# 取得元: ローカルは `npx supabase status` の API_URL、本番は Supabase Dashboard の Project URL
SUPABASE_URL=http://127.0.0.1:54321

# Todo データアクセス用の publishable key (Server Action の app-client が使用する)
# 取得元: ローカルは `npx supabase status` の PUBLISHABLE_KEY、本番は Supabase Dashboard の API Settings
SUPABASE_PUBLISHABLE_KEY=

# Auth.js Adapter 専用の secret key (next_auth schema への書き込みに使用する)
# 取得元: ローカルは `npx supabase status` の SECRET_KEY、本番は Supabase Dashboard の API Settings
# クライアントバンドルに含めてはならない (NEXT_PUBLIC_ 接頭辞を付けない)
SUPABASE_SECRET_KEY=

# Custom JWT の署名鍵 (HS256、Supabase プロジェクトの legacy JWT secret)
# 取得元: ローカルは `npx supabase status` の JWT_SECRET、本番は Supabase Dashboard の API Settings (JWT Secret)
# クライアントバンドルに含めてはならない (NEXT_PUBLIC_ 接頭辞を付けない)
SUPABASE_JWT_SECRET=
